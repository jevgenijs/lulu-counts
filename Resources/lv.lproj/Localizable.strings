"Tap the smaller number." = "Uzspied uz mazāko skaitli.";
"Tap the biggest number." = "Uzspied uz vislielāko skaitli.";
"Tap the smallest number." = "Uzspied uz vismazāko skaitli.";
"Which sign fits?" = "Kura zīme der?";
"How many tens are there?" = "Cik tur ir desmitu?";
"How many ones are there?" = "Cik tur ir vienu?";
"What number is shown?" = "Kāds skaitlis ir parādīts?";
"Write the number. Tens: %@, ones: %@." = "Uzraksti skaitli. Desmiti: %@, vieni: %@.";
"Write the number. Hundreds: %@, tens: %@, ones: %@." = "Uzraksti skaitli. Simti: %@, desmiti: %@, vieni: %@.";
"What is the value of the digit %@?" = "Kāda ir cipara %@ vērtība?";
"Find the shape: %@" = "Atrodi figūru: %@";
"How many sides does this shape have?" = "Cik malu ir šai figūrai?";
"Find the shape with 4 equal sides and square corners." = "Atrodi figūru ar 4 vienādām malām un taisniem leņķiem.";
"Find the shape with 4 equal sides and leaning corners." = "Atrodi figūru ar 4 vienādām malām un slīpiem leņķiem.";
"Find the shape with %@ sides." = "Atrodi figūru. Malu skaits: %@.";
"What time is it?" = "Cik pulkstenis?";
"Tap the clock that shows %@" = "Uzspied uz pulksteņa, kas rāda %@";
